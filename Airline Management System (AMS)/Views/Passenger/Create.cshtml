@model Airline_Management_System__AMS_.ViewModels.PassengerViewModel

@{
    ViewData["Title"] = "Create Passenger";
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<style>
    .card-header-airline {
        background-color: #FF6600 !important;
        color: white !important;
    }

    .btn-primary {
        background-color: #FF6600 !important;
        border-color: #FF6600 !important;
    }

    .btn-primary:hover {
        background-color: #CC5200 !important;
        border-color: #CC5200 !important;
    }
</style>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header card-header-airline py-3">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-user-plus me-2"></i>@Localizer["Create New Passenger"]</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <!-- Personal Details Section -->
                        <div class="alert alert-info">
                            <strong>@Localizer["Personal Information"]</strong>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label fw-bold">@Localizer["First Name"]</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fas fa-user"></i></span>
                                    <input asp-for="FirstName" class="form-control" placeholder="@Localizer["Enter first name"]" />
                                </div>
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label fw-bold">@Localizer["Last Name"]</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fas fa-user"></i></span>
                                    <input asp-for="LastName" class="form-control" placeholder="@Localizer["Enter last name"]" />
                                </div>
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label fw-bold">@Localizer["Email Address"]</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fas fa-envelope"></i></span>
                                    <input asp-for="Email" type="email" class="form-control"
                                        placeholder="@Localizer["name@example.com"]" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="PhoneNumber" class="form-label fw-bold">@Localizer["Phone Number"]</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fas fa-phone"></i></span>
                                    <input asp-for="PhoneNumber" class="form-control" placeholder="@Localizer["+1 234 567 890"]" />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PassportNumber" class="form-label fw-bold">@Localizer["Passport Number"]</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fas fa-passport"></i></span>
                                    <input asp-for="PassportNumber" class="form-control" placeholder="@Localizer["Enter passport number"]" />
                                </div>
                                <span asp-validation-for="PassportNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="NationalId" class="form-label fw-bold">@Localizer["National ID"]</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fas fa-id-card"></i></span>
                                    <input asp-for="NationalId" class="form-control"
                                        placeholder="National ID (Optional)" />
                                </div>
                                <span asp-validation-for="NationalId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Role" class="form-label fw-bold">Account Role</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fas fa-user-shield"></i></span>
                                    <select asp-for="Role" class="form-select">
                                        <option value="Customer">Customer</option>
                                        <option value="Admin">Admin</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Role" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Back to List
                            </a>
                            <button type="submit" class="btn btn-primary px-4 fw-bold">
                                <i class="fas fa-save me-2"></i>Create Passenger
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
