@model IEnumerable<Airline_Management_System__AMS_.Models.Passenger>

@{
    ViewData["Title"] = "Passenger Management";
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" />

<style>
    /* Airline Theme Color Overrides */
    .text-primary {
        color: #002244 !important;
    }

    .btn-primary {
        background-color: #FF6600 !important;
        border-color: #FF6600 !important;
        color: white !important;
    }

    .btn-primary:hover {
        background-color: #CC5200 !important;
        border-color: #CC5200 !important;
    }

    .btn-outline-primary {
        color: #0077CC !important;
        border-color: #0077CC !important;
    }

    .btn-outline-primary:hover {
        background-color: #0077CC !important;
        border-color: #0077CC !important;
        color: white !important;
    }

    .bg-primary {
        background-color: #002244 !important;
    }

    .card-header.bg-white h5 {
        color: #002244 !important;
    }

    h1.text-primary,
    h5.text-primary {
        color: #002244 !important;
    }

    .avatar-circle.bg-primary {
        background-color: #002244 !important;
    }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 text-primary fw-bold">
                <i class="fas fa-users me-2"></i>@Localizer["Passenger Management"]
            </h1>
            <p class="text-muted">@Localizer["View and manage passenger information and profiles"]</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>@Localizer["Add New Passenger"]
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-3 border-bottom">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h5 class="mb-0 text-primary fw-bold">@Localizer["Passenger List"]</h5>
                </div>
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="fas fa-search text-muted"></i>
                        </span>
                        <input type="text" id="passengerSearch" class="form-control border-start-0 bg-light"
                            placeholder="@Localizer["Search by name, email, or passport..."]">
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">@Localizer["Full Name"]</th>
                            <th>@Localizer["Contact Info"]</th>
                            <th>@Localizer["Passport / ID"]</th>
                            <th>@Localizer["Status"]</th>
                            <th>@Localizer["Link Status"]</th>
                            <th class="text-end pe-4">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody id="passengerTableBody">
                        @foreach (var item in Model)
                        {
                            <tr class="@(item.IsArchived ? "bg-light text-muted" : "")">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle me-3 @(item.IsArchived ? "bg-secondary" : "bg-primary") text-white d-flex align-items-center justify-content-center rounded-circle"
                                            style="width: 40px; height: 40px;">
                                            @item.FirstName.Substring(0, 1)@item.LastName.Substring(0, 1)
                                        </div>
                                        <div>
                                            <div class="fw-bold">@item.FullName</div>
                                            <small class="text-muted">ID: @item.Id</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div><i class="fas fa-envelope me-2 text-muted"></i>@item.Email</div>
                                    <div><i class="fas fa-phone me-2 text-muted"></i>@item.PhoneNumber</div>
                                </td>
                                <td>
                                    <div><i class="fas fa-passport me-2 text-muted"></i>@item.PassportNumber</div>
                                    @if (!string.IsNullOrEmpty(item.NationalId))
                                    {
                                        <div><small class="text-muted">@Localizer["ID:"] @item.NationalId</small></div>
                                    }
                                </td>
                                <td>
                                    @if (item.IsArchived)
                                    {
                                        <span class="badge bg-secondary">@Localizer["Archived"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@Localizer["Active"]</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.UserId))
                                    {
                                        <span class="badge bg-info"><i class="fas fa-link me-1"></i>@Localizer["Linked"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark"><i
                                                class="fas fa-user-tag me-1"></i>@Localizer["Walk-in"]</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                            class="btn btn-sm btn-outline-primary" title="@Localizer["View Details"]">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning"
                                            title="@Localizer["Edit"]">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        @if (item.IsArchived)
                                        {
                                            <form asp-action="Restore" asp-route-id="@item.Id" method="post" class="d-inline"
                                                onsubmit="return confirm('Restore this passenger?');">
                                                <button type="submit" class="btn btn-sm btn-outline-success"
                                                    title="@Localizer["Restore"]">
                                                    <i class="fas fa-trash-restore"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"
                                                title="@Localizer["Archive"]">
                                                <i class="fas fa-archive"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('passengerSearch').addEventListener('keyup', function () {
        let searchText = this.value.toLowerCase();
        let tableRows = document.querySelectorAll('#passengerTableBody tr');

        tableRows.forEach(row => {
            let rowText = row.innerText.toLowerCase();
            if (rowText.includes(searchText)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    });
</script>
